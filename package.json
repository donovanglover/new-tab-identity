{
  "name": "new-tab-identity",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite build --watch",
    "build": "vite build --minify && web-ext build -s ./dist -a ./dist --overwrite-dest",
    "lint": "oxlint && npm run build && web-ext lint -s ./dist",
    "test": "vitest run",
    "start": "web-ext run --source-dir ./dist"
  },
  "dependencies": {
    "clsx": "^2.1.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-hot-toast": "^2.6.1",
    "react-icons": "^5.7.0"
  },
  "devDependencies": {
    "@donovanglover/base16-tailwind": "npm:@jsr/donovanglover__base16-tailwind@^0.1.7",
    "@testing-library/react": "^16.3.3",
    "@types/firefox-webext-browser": "^143.0.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitest/coverage-istanbul": "^5.0.5",
    "jsdom": "^30.1.3",
    "tailwindcss": "^3.4.17",
    "vite": "^8.3.5",
    "vitest": "^5.0.5",
    "web-ext": "^10.8.0"
  }
}
